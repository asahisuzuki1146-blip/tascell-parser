/*
 * 拡張C (Tascell) → 拡張SC (S式) パーザ
 *
 * 文法の方針:
 *  - キーワードの直後には !IdChar を置き、識別子の一部に誤一致しないようにする
 *    (例: "longest" を "long" + "est" と読まない)。
 *  - 識別子 Identifier は予約語 Reserved を受け付けない
 *    (例: "return -x;" の return を変数名として読まない)。
 *  - 二項演算は「先頭 + 繰り返し」で読み、左畳み込みで S 式を作る (左結合)。
 *  - 文字列リテラルは SC の書式 (\n → ~%, ~ → ~~) に変換する。
 */
module TascellC;

body {
  /* 二項演算・後置演算の「演算子 + 被演算子」 */
  static final class Tail {
    final String op, arg;
    Tail(String op, String arg) { this.op = op; this.arg = arg; }
  }

  private static String flatten(xtc.util.Pair<Character> cs) {
    StringBuilder sb = new StringBuilder();
    for (char c : cs) sb.append(c);
    return sb.toString();
  }

  private static String join(xtc.util.Pair<String> xs, String sep) {
    StringBuilder sb = new StringBuilder();
    boolean first = true;
    for (String x : xs) {
      if (!first) sb.append(sep);
      sb.append(x);
      first = false;
    }
    return sb.toString();
  }

  /* 左結合の畳み込み: first (op1 e1) (op2 e2) ... → (op2 (op1 first e1) e2) */
  private static String foldLeft(String first, xtc.util.Pair<Tail> tail) {
    String acc = first;
    for (Tail t : tail) acc = "(" + t.op + " " + acc + " " + guardRight(t.op, t.arg) + ")";
    return acc;
  }

  /* sc2c は (- x (- y)) を x--y、(+ x (++ y)) を x+++y と出力してしまう。
   * 右辺が同じ記号の単項演算なら (exps ...) で包み、括弧付きで出力させる。 */
  private static String guardRight(String op, String r) {
    if (!op.equals("-") && !op.equals("+")) return r;
    boolean unary = (r.startsWith("(" + op + " ") && countArgs(r) == 1)
                 || r.startsWith("(" + op + op + " ");
    return unary ? "(exps " + r + ")" : r;
  }

  /* S 式 "(head a b ...)" の引数の個数 (文字列内の括弧は数えない) */
  private static int countArgs(String form) {
    int depth = 0, items = 0;
    boolean inItem = false;
    for (int i = 0; i < form.length(); i++) {
      char c = form.charAt(i);
      if (c == '"') {
        for (i++; i < form.length() && form.charAt(i) != '"'; i++) if (form.charAt(i) == '\\') i++;
        if (depth == 1 && !inItem) { items++; inItem = true; }
        continue;
      }
      if (c == '(') {
        depth++;
        if (depth == 2) { items++; inItem = true; }
      } else if (c == ')') {
        depth--;
        if (depth == 1) inItem = false;
      } else if (depth == 1) {
        if (Character.isWhitespace(c)) inItem = false;
        else if (!inItem) { items++; inItem = true; }
      }
    }
    return items - 1;  /* 先頭の演算子を除く */
  }

  /* 後置演算子の畳み込み: 添字・関数呼び出し・フィールド参照・後置 ++/-- */
  private static String foldPostfix(String base, xtc.util.Pair<Tail> tail) {
    String acc = base;
    for (Tail t : tail) {
      switch (t.op) {
        case "aref": acc = "(aref " + acc + " " + t.arg + ")"; break;
        case "call": acc = "(" + acc + (t.arg.isEmpty() ? "" : " " + t.arg) + ")"; break;
        case "fref": acc = acc.equals("this") ? "this." + t.arg
                                              : "(fref " + acc + " " + t.arg + ")"; break;
        case "inc":  acc = "(inc " + acc + ")"; break;
        case "dec":  acc = "(dec " + acc + ")"; break;
        default: throw new IllegalStateException(t.op);
      }
    }
    return acc;
  }

  /* 複合代入。SC の (%= ...) は SC プリプロセッサの % 指令と衝突するため展開する */
  private static String assign(String op, String l, String r) {
    if (op.equals("%=")) return "(= " + l + " (% " + l + " " + r + "))";
    return "(" + op + " " + l + " " + r + ")";
  }

  private static String ptrs(String base, String stars) {
    String t = base;
    for (int i = 0; i < stars.length(); i++) t = "(ptr " + t + ")";
    return t;
  }

  private static String paramNames(String packed) {
    StringBuilder sb = new StringBuilder();
    for (String p : packed.split(",")) {
      String[] parts = p.trim().split(":");
      if (parts.length == 2) sb.append(parts[0].trim()).append(" ");
    }
    return sb.toString().trim();
  }

  private static String paramTypes(String packed) {
    StringBuilder sb = new StringBuilder();
    for (String p : packed.split(",")) {
      String[] parts = p.trim().split(":");
      if (parts.length == 2) sb.append(parts[1].trim()).append(" ");
    }
    return sb.toString().trim();
  }

  /* 関数シグネチャ: (name p1 p2) (wfn ret t1 t2) */
  private static String sig(String name, String params, String kind, String ret) {
    return "(" + (name + " " + paramNames(params)).trim() + ") ("
         + (kind + " " + ret + " " + paramTypes(params)).trim() + ")";
  }

  /* "(begin a b)" → "a b"  (handles の put/get 本体用) */
  private static String unbegin(String s) {
    return s.startsWith("(begin") && s.endsWith(")")
      ? s.substring(6, s.length() - 1).trim() : s;
  }

  /* C のエスケープ文字 → SC (Common Lisp 文字列 + format 指令) */
  private static String escToSC(char c) {
    switch (c) {
      case 'n':  return "~%";
      case 't':  return "\t";
      case '\\': return "\\\\";
      case '"':  return "\\\"";
      case '\'': return "'";
      default: throw new IllegalStateException("unsupported escape: \\" + c);
    }
  }
}

/* ------------------------------------------------------------------ */
/* トップレベル                                                         */
/* ------------------------------------------------------------------ */

public String start =
    Spacing ds:TopDecl* EOF
    { yyValue = join(ds, "\n") + "\n"; } ;

String TopDecl =
    WorkerDecl
  / TaskBodyDecl
  / TaskReceiverDecl
  / TaskSenderDecl
  / RsltSenderDecl
  / RsltReceiverDecl
  / TaskExecDecl
  / TaskDecl
  / FuncForwardDecl
  / GlobalVarDecl
  / FuncDecl ;

String GlobalVarDecl =
    t:TypeSpec n:Identifier "=" !"=" Spacing e:Expr ";" Spacing
    { yyValue = "(def " + n + " " + t + " " + e + ")"; }
  / t:TypeSpec n:Identifier ";" Spacing
    { yyValue = "(def " + n + " " + t + ")"; } ;

String TaskReceiverDecl =
    "task_receiver" !IdChar Spacing name:Identifier b:BraceBody
    { yyValue = "(def (task-receiver " + name + ")" + b + ")"; } ;

String TaskSenderDecl =
    "task_sender" !IdChar Spacing name:Identifier b:BraceBody
    { yyValue = "(def (task-sender " + name + ")" + b + ")"; } ;

String RsltSenderDecl =
    "rslt_sender" !IdChar Spacing name:Identifier b:BraceBody
    { yyValue = "(def (rslt-sender " + name + ")" + b + ")"; } ;

String RsltReceiverDecl =
    "rslt_receiver" !IdChar Spacing name:Identifier b:BraceBody
    { yyValue = "(def (rslt-receiver " + name + ")" + b + ")"; } ;

String TaskBodyDecl =
    "task_body" !IdChar Spacing name:Identifier b:BraceBody
    { yyValue = "(def (task-body " + name + ")" + b + ")"; } ;

/* PPoPP 2009 の task_exec は、現行 sc-tascell の (def (task-body ...)) に対応する */
String TaskExecDecl =
    "task_exec" !IdChar Spacing name:Identifier b:BraceBody
    { yyValue = "(def (task-body " + name + ")" + b + ")"; } ;

/* { 文* } → 先頭に改行を付けた文の並び (空なら空文字列) */
String BraceBody =
    "{" Spacing ss:Stmt* "}" Spacing
    { yyValue = ss.isEmpty() ? "" : "\n  " + join(ss, "\n  "); } ;

String FuncForwardDecl =
    "decl" !IdChar Spacing ret:TypeSpec name:Identifier
    "(" Spacing params:ParamList ")" Spacing ";" Spacing
    { yyValue = "(decl " + sig(name, params, "wfn", ret) + ")"; } ;

String WorkerDecl =
    "worker" !IdChar Spacing ret:TypeSpec name:Identifier
    "(" Spacing params:ParamList ")" Spacing
    body:CompoundStmt
    { yyValue = "(def " + sig(name, params, "wfn", ret) + "\n  " + body + ")"; } ;

String FuncDecl =
    ret:TypeSpec name:Identifier
    "(" Spacing params:ParamList ")" Spacing
    body:CompoundStmt
    { yyValue = "(def " + sig(name, params, "fn", ret) + "\n  " + body + ")"; } ;

String TaskDecl =
    "task" !IdChar Spacing name:Identifier "{" Spacing
    fs:TaskField*
    "}" Spacing ";" Spacing
    { yyValue = "(def (task " + name + ")\n" + join(fs, "") + ")"; } ;

String TaskField =
    dir:TaskDir t:TypeSpec n:Identifier ";" Spacing
    { yyValue = "  (def " + n + " " + t + dir + ")\n"; } ;

String TaskDir =
    "in"  !IdChar Spacing ":" Spacing { yyValue = " :in"; }
  / "out" !IdChar Spacing ":" Spacing { yyValue = " :out"; }
  / /* empty */                       { yyValue = ""; } ;

String ParamList =
    t:TypeSpec n:Identifier "," Spacing rest:ParamList
    { yyValue = n + ":" + t + "," + rest; }
  / t:TypeSpec n:Identifier
    { yyValue = n + ":" + t; }
  / /* empty */
    { yyValue = ""; } ;

/* ------------------------------------------------------------------ */
/* 型                                                                   */
/* ------------------------------------------------------------------ */

String TypeSpec = b:BaseType s:Stars { yyValue = ptrs(b, s); } ;

String BaseType =
    "void"   !IdChar Spacing { yyValue = "void";   }
  / "int"    !IdChar Spacing { yyValue = "int";    }
  / "long"   !IdChar Spacing { yyValue = "long";   }
  / "double" !IdChar Spacing { yyValue = "double"; }
  / "char"   !IdChar Spacing { yyValue = "char";   }
  / "float"  !IdChar Spacing { yyValue = "float";  } ;

String Stars =
    "*" Spacing rest:Stars { yyValue = "*" + rest; }
  / /* empty */            { yyValue = ""; } ;

/* ------------------------------------------------------------------ */
/* 文                                                                   */
/* ------------------------------------------------------------------ */

String Stmt =
    DoTwoStmt
  / ParallelForStmt
  / DynamicWindStmt
  / IfStmt
  / WhileStmt
  / ForStmt
  / ReturnStmt
  / BreakStmt
  / ContinueStmt
  / VarDeclStmt
  / CompoundStmt
  / ExprStmt ;

String ForStmt =
    "for" !IdChar Spacing "(" Spacing init:ForInit ";" Spacing cond:Expr ";" Spacing step:Expr ")" Spacing body:Stmt
    { yyValue = "(for (" + init + " " + cond + " " + step + ") " + body + ")"; } ;

String ForInit =
    t:TypeSpec n:Identifier "=" !"=" Spacing e:Expr { yyValue = "(def " + n + " " + t + " " + e + ")"; }
  / e:Expr                                          { yyValue = e; }
  / /* empty */                                     { yyValue = "()"; } ;

String DoTwoStmt =
    "do_two" !IdChar Spacing s1:Stmt s2:Stmt h:HandlesOpt
    { yyValue = "(do-two " + s1 + " " + s2 + h + ")"; } ;

String HandlesOpt =
    "handles" !IdChar Spacing name:Identifier "{" Spacing
    "put" !IdChar Spacing ":" Spacing put:CompoundStmt
    "get" !IdChar Spacing ":" Spacing get:CompoundStmt
    "}" Spacing
    { yyValue = "\n  (handles " + name + "\n    (:put " + unbegin(put) + ")\n    (:get " + unbegin(get) + "))"; }
  / /* empty */ { yyValue = ""; } ;

String ParallelForStmt =
    "for" !IdChar Spacing "(" Spacing "int" !IdChar Spacing id:Identifier
    ":" Spacing from:Expr "," Spacing to:Expr ")" Spacing
    body:Stmt
    { yyValue = "(for " + id + " " + from + " " + to + " " + body + ")"; } ;

String DynamicWindStmt =
    "dynamic_wind" !IdChar Spacing before:Stmt body:Stmt after:Stmt
    { yyValue = "(dynamic-wind " + before + " " + body + " " + after + ")"; } ;

String IfStmt =
    "if" !IdChar Spacing "(" Spacing cond:Expr ")" Spacing then:Stmt "else" !IdChar Spacing els:Stmt
    { yyValue = "(if " + cond + " " + then + " " + els + ")"; }
  / "if" !IdChar Spacing "(" Spacing cond:Expr ")" Spacing then:Stmt
    { yyValue = "(if " + cond + " " + then + ")"; } ;

String WhileStmt =
    "while" !IdChar Spacing "(" Spacing cond:Expr ")" Spacing body:Stmt
    { yyValue = "(while " + cond + " " + body + ")"; } ;

String ReturnStmt =
    "return" !IdChar Spacing e:Expr ";" Spacing { yyValue = "(return " + e + ")"; }
  / "return" !IdChar Spacing ";" Spacing        { yyValue = "(return)"; } ;

String BreakStmt =
    "break" !IdChar Spacing ";" Spacing { yyValue = "(break)"; } ;

String ContinueStmt =
    "continue" !IdChar Spacing ";" Spacing { yyValue = "(continue)"; } ;

String VarDeclStmt =
    t:TypeSpec n:Identifier "=" !"=" Spacing e:Expr ";" Spacing
    { yyValue = "(def " + n + " " + t + " " + e + ")"; }
  / t:TypeSpec n:Identifier ";" Spacing
    { yyValue = "(def " + n + " " + t + ")"; } ;

String CompoundStmt =
    "{" Spacing ss:Stmt* "}" Spacing
    { yyValue = "(begin" + (ss.isEmpty() ? "" : " " + join(ss, " ")) + ")"; } ;

String ExprStmt =
    e:Expr ";" Spacing { yyValue = e; } ;

/* ------------------------------------------------------------------ */
/* 式 (優先順位の低い順)                                                 */
/* ------------------------------------------------------------------ */

String Expr = AssignExpr ;

/* 代入は右結合 */
String AssignExpr =
    l:UnaryExpr op:AssignOp r:AssignExpr { yyValue = assign(op, l, r); }
  / LogOrExpr ;

String AssignOp =
    "="  !"=" Spacing { yyValue = "=";  }
  / "+=" Spacing      { yyValue = "+="; }
  / "-=" Spacing      { yyValue = "-="; }
  / "*=" Spacing      { yyValue = "*="; }
  / "/=" Spacing      { yyValue = "/="; }
  / "%=" Spacing      { yyValue = "%="; } ;

String LogOrExpr  = l:LogAndExpr t:LogOrTail*  { yyValue = foldLeft(l, t); } ;
Tail LogOrTail =
    "||" Spacing r:LogAndExpr { yyValue = new Tail("or", r); } ;

String LogAndExpr = l:EqExpr t:LogAndTail* { yyValue = foldLeft(l, t); } ;
Tail LogAndTail =
    "&&" Spacing r:EqExpr { yyValue = new Tail("and", r); } ;

String EqExpr = l:RelExpr t:EqTail* { yyValue = foldLeft(l, t); } ;
Tail EqTail =
    "==" Spacing r:RelExpr { yyValue = new Tail("==", r); }
  / "!=" Spacing r:RelExpr { yyValue = new Tail("!=", r); } ;

String RelExpr = l:AddExpr t:RelTail* { yyValue = foldLeft(l, t); } ;
Tail RelTail =
    "<=" Spacing r:AddExpr { yyValue = new Tail("<=", r); }
  / ">=" Spacing r:AddExpr { yyValue = new Tail(">=", r); }
  / "<"  Spacing r:AddExpr { yyValue = new Tail("<", r); }
  / ">"  Spacing r:AddExpr { yyValue = new Tail(">", r); } ;

String AddExpr = l:MulExpr t:AddTail* { yyValue = foldLeft(l, t); } ;
Tail AddTail =
    "+" ![+=] Spacing r:MulExpr { yyValue = new Tail("+", r); }
  / "-" ![\-=>] Spacing r:MulExpr { yyValue = new Tail("-", r); } ;

String MulExpr = l:UnaryExpr t:MulTail* { yyValue = foldLeft(l, t); } ;
Tail MulTail =
    "*" !"=" Spacing r:UnaryExpr { yyValue = new Tail("*", r); }
  / "/" !"=" Spacing r:UnaryExpr { yyValue = new Tail("/", r); }
  / "%" !"=" Spacing r:UnaryExpr { yyValue = new Tail("%", r); } ;

String UnaryExpr =
    "++" Spacing e:UnaryExpr                       { yyValue = "(++ " + e + ")"; }
  / "--" Spacing e:UnaryExpr                       { yyValue = "(-- " + e + ")"; }
  / "(" Spacing t:TypeSpec ")" Spacing e:UnaryExpr { yyValue = "(cast " + t + " " + e + ")"; }
  / "-" Spacing e:UnaryExpr                        { yyValue = "(- " + e + ")"; }
  / "+" Spacing e:UnaryExpr                        { yyValue = e; }
  / "!" !"=" Spacing e:UnaryExpr                   { yyValue = "(not " + e + ")"; }
  / "*" Spacing e:UnaryExpr                        { yyValue = "(mref " + e + ")"; }
  / "&" !"&" Spacing e:UnaryExpr                   { yyValue = "(ptr " + e + ")"; }
  / PostfixExpr ;

String PostfixExpr = b:PrimaryExpr t:PostfixTail* { yyValue = foldPostfix(b, t); } ;

Tail PostfixTail =
    "[" Spacing i:Expr "]" Spacing        { yyValue = new Tail("aref", i); }
  / "(" Spacing a:ArgList ")" Spacing     { yyValue = new Tail("call", a); }
  / "." Spacing f:Identifier              { yyValue = new Tail("fref", f); }
  / "++" Spacing                          { yyValue = new Tail("inc", ""); }
  / "--" Spacing                          { yyValue = new Tail("dec", ""); } ;

String ArgList =
    a:Expr rest:ArgTail* { yyValue = a + (rest.isEmpty() ? "" : " " + join(rest, " ")); }
  / /* empty */          { yyValue = ""; } ;

String ArgTail = "," Spacing a:Expr { yyValue = a; } ;

String PrimaryExpr =
    "(" Spacing e:Expr ")" Spacing                  { yyValue = e; }
  / s:StringLit Spacing                             { yyValue = s; }
  / "this" !IdChar Spacing                          { yyValue = "this"; }
  / "csym" Spacing "::" Spacing n:Identifier        { yyValue = "csym::" + n; }
  / Identifier
  / Number ;

String Number =
    h:[0-9] t:[0-9]* "." d:[0-9]+ !IdChar Spacing { yyValue = h + flatten(t) + "." + flatten(d); }
  / h:[0-9] t:[0-9]* !IdChar Spacing              { yyValue = h + flatten(t); } ;

/* ------------------------------------------------------------------ */
/* 字句                                                                 */
/* ------------------------------------------------------------------ */

String Identifier =
    !Reserved h:[a-zA-Z_] t:[a-zA-Z0-9_]* Spacing { yyValue = h + flatten(t); } ;

transient void IdChar = [a-zA-Z0-9_] ;

/* 識別子として使えない語。それぞれ単語境界を確認する */
transient void Reserved =
    "void" !IdChar / "int" !IdChar / "long" !IdChar / "double" !IdChar
  / "char" !IdChar / "float" !IdChar
  / "if" !IdChar / "else" !IdChar / "while" !IdChar / "for" !IdChar
  / "return" !IdChar / "break" !IdChar / "continue" !IdChar
  / "worker" !IdChar / "task" !IdChar / "task_exec" !IdChar / "task_body" !IdChar
  / "task_sender" !IdChar / "task_receiver" !IdChar
  / "rslt_sender" !IdChar / "rslt_receiver" !IdChar
  / "decl" !IdChar / "do_two" !IdChar / "dynamic_wind" !IdChar
  / "handles" !IdChar / "this" !IdChar / "csym" !IdChar ;

/* 文字列: C のエスケープを SC 形式に変換する (未対応のエスケープはパースエラー) */
String StringLit =
    "\"" cs:StringChar* "\""
    { yyValue = "\"" + join(cs, "") + "\""; } ;

String StringChar =
    '\\' c:[nt\\\"'] { yyValue = escToSC(c); }
  / '~'              { yyValue = "~~"; }
  / c:(![\"\\\n] _)  { yyValue = String.valueOf(c); } ;

transient void Spacing = ([ \t\n\r] / Comment)* ;

transient void Comment =
    "//" (![\n\r] _)*
  / "/*" ('*' !'/' / !'*' _)* "*/"
  ;

transient void EOF = !_ ;
