module TascellC;

body {
  private String flatten(xtc.util.Pair<Character> cs) {
    StringBuilder sb = new StringBuilder();
    for (char c : cs) sb.append(c);
    return sb.toString();
  }
  private String paramNames(String packed) {
    StringBuilder sb = new StringBuilder();
    for (String p : packed.split(",")) {
      String[] parts = p.trim().split(":");
      if (parts.length == 2) sb.append(parts[0].trim()).append(" ");
    }
    return sb.toString().trim();
  }
  private String paramTypes(String packed) {
    StringBuilder sb = new StringBuilder();
    for (String p : packed.split(",")) {
      String[] parts = p.trim().split(":");
      if (parts.length == 2) sb.append(parts[1].trim()).append(" ");
    }
    return sb.toString().trim();
  }
}

public String start =
    Spacing ds:TopDeclList EOF
    { yyValue = ds; } ;

String TopDeclList =
    d:TopDecl rest:TopDeclList { yyValue = d + "\n" + rest; }
  / /* empty */                { yyValue = ""; } ;

String TopDecl =
    WorkerDecl
  / TaskBodyDecl
  / TaskReceiverDecl
  / TaskSenderDecl
  / RsltSenderDecl
  / RsltReceiverDecl
  / TaskExecDecl
  / TaskDecl
  / FuncForwardDecl
  / GlobalVarDecl
  / FuncDecl ;

String GlobalVarDecl =
    t:TypeSpec n:Atom "=" Spacing e:Expr ";" Spacing
    { yyValue = "(def " + n + " " + t + " " + e + ")"; }
  / t:TypeSpec n:Atom ";" Spacing
    { yyValue = "(def " + n + " " + t + ")"; } ;

String TaskReceiverDecl =
    "task_receiver" Spacing name:Atom "{" Spacing body:StmtList "}" Spacing
    { yyValue = "(def (task-receiver " + name + ")\n" + body + ")"; } ;

String TaskSenderDecl =
    "task_sender" Spacing name:Atom "{" Spacing body:StmtList "}" Spacing
    { yyValue = "(def (task-sender " + name + ")\n" + body + ")"; } ;

String RsltSenderDecl =
    "rslt_sender" Spacing name:Atom "{" Spacing body:StmtList "}" Spacing
    { yyValue = "(def (rslt-sender " + name + ")\n" + body + ")"; } ;

String RsltReceiverDecl =
    "rslt_receiver" Spacing name:Atom "{" Spacing body:StmtList "}" Spacing
    { yyValue = "(def (rslt-receiver " + name + ")\n" + body + ")"; } ;

String FuncForwardDecl =
    "decl" Spacing ret:TypeSpec name:Atom
    "(" Spacing params:ParamList ")" Spacing ";" Spacing
    { yyValue = "(decl (" + name + " " + paramNames(params) + ") (wfn " + ret + " " + paramTypes(params) + "))"; } ;

String TaskBodyDecl =
    "task_body" Spacing name:Atom "{" Spacing
    body:StmtList
    "}" Spacing
    { yyValue = "(def (task-body " + name + ")\n" + body + ")"; } ;

String WorkerDecl =
    "worker" Spacing ret:TypeSpec name:Atom
    "(" Spacing params:ParamList ")" Spacing
    body:CompoundStmt
    { yyValue = "(def (" + name + " " + paramNames(params) + ") (wfn " + ret + " " + paramTypes(params) + ")\n  " + body + ")"; } ;

String FuncDecl =
    ret:TypeSpec name:Atom
    "(" Spacing params:ParamList ")" Spacing
    body:CompoundStmt
    { yyValue = "(def (" + name + " " + paramNames(params) + ") (fn " + ret + " " + paramTypes(params) + ")\n  " + body + ")"; } ;

String TaskDecl =
    "task" Spacing name:Atom "{" Spacing
    fields:TaskFieldList
    "}" Spacing ";" Spacing
    { yyValue = "(def (task " + name + ")\n" + fields + ")"; } ;

String TaskFieldList =
    f:TaskField rest:TaskFieldList { yyValue = f + rest; }
  / /* empty */                   { yyValue = ""; } ;

String TaskField =
    dir:TaskDir t:TypeSpec n:Atom ";" Spacing
    { yyValue = "  (def " + n + " " + t + " " + dir + ")\n"; } ;

String TaskDir =
    "in"  Spacing ":" Spacing { yyValue = ":in"; }
  / "out" Spacing ":" Spacing { yyValue = ":out"; }
  / /* empty */               { yyValue = ""; } ;

String TaskExecDecl =
    "task_exec" Spacing name:Atom "{" Spacing
    body:StmtList
    "}" Spacing
    { yyValue = "(task-exec " + name + "\n" + body + ")"; } ;

String ParamList =
    t:TypeSpec n:Atom "," Spacing rest:ParamList
    { yyValue = n + ":" + t + "," + rest; }
  / t:TypeSpec n:Atom
    { yyValue = n + ":" + t; }
  / /* empty */
    { yyValue = ""; } ;

String TypeSpec =
    "void"   Spacing ptr:PtrOpt { yyValue = ptr.isEmpty() ? "void"   : "(ptr void)";   }
  / "int"    Spacing ptr:PtrOpt { yyValue = ptr.isEmpty() ? "int"    : "(ptr int)";    }
  / "long"   Spacing ptr:PtrOpt { yyValue = ptr.isEmpty() ? "long"   : "(ptr long)";   }
  / "double" Spacing ptr:PtrOpt { yyValue = ptr.isEmpty() ? "double" : "(ptr double)"; }
  / "char"   Spacing ptr:PtrOpt { yyValue = ptr.isEmpty() ? "char"   : "(ptr char)";   }
  / "float"  Spacing ptr:PtrOpt { yyValue = ptr.isEmpty() ? "float"  : "(ptr float)";  } ;

String PtrOpt =
    "*" Spacing { yyValue = "*"; }
  / /* empty */ { yyValue = ""; } ;

String Stmt =
    DoTwoStmt
  / ParallelForStmt
  / DynamicWindStmt
  / IfStmt
  / WhileStmt
  / ForStmt
  / ReturnStmt
  / VarDeclStmt
  / CompoundStmt
  / ExprStmt ;

String ForStmt =
    "for" Spacing "(" Spacing init:ForInit ";" Spacing cond:Expr ";" Spacing step:Expr ")" Spacing body:Stmt
    { yyValue = "(for (" + init + " " + cond + " " + step + ") " + body + ")"; } ;

String ForInit =
    t:TypeSpec n:Atom "=" Spacing e:Expr { yyValue = "(def " + n + " " + t + " " + e + ")"; }
  / e:Expr                               { yyValue = e; }
  / /* empty */                          { yyValue = ""; } ;

String DoTwoStmt =
    "do_two" Spacing s1:Stmt s2:Stmt h:HandlesOpt
    { yyValue = "(do-two " + s1 + " " + s2 + h + ")"; } ;

String HandlesOpt =
    "handles" Spacing name:Atom "{" Spacing
    "put" Spacing ":" Spacing put:CompoundStmt
    "get" Spacing ":" Spacing get:CompoundStmt
    "}" Spacing
    { String p = put.startsWith("(begin ") && put.endsWith(")") ? put.substring(7, put.length()-1).trim() : put;
      String g = get.startsWith("(begin ") && get.endsWith(")") ? get.substring(7, get.length()-1).trim() : get;
      yyValue = "\n  (handles " + name + "\n    (:put " + p + ")\n    (:get " + g + "))"; }
  / /* empty */ { yyValue = ""; } ;

String ParallelForStmt =
    "for" Spacing "(" Spacing "int" Spacing id:Atom
    ":" Spacing from:Expr "," Spacing to:Expr ")" Spacing
    body:Stmt
    { yyValue = "(for " + id + " " + from + " " + to + " " + body + ")"; } ;

String DynamicWindStmt =
    "dynamic_wind" Spacing before:Stmt body:Stmt after:Stmt
    { yyValue = "(dynamic-wind " + before + " " + body + " " + after + ")"; } ;

String IfStmt =
    "if" Spacing "(" Spacing cond:Expr ")" Spacing then:Stmt "else" Spacing els:Stmt
    { yyValue = "(if " + cond + " " + then + " " + els + ")"; }
  / "if" Spacing "(" Spacing cond:Expr ")" Spacing then:Stmt
    { yyValue = "(if " + cond + " " + then + ")"; } ;

String WhileStmt =
    "while" Spacing "(" Spacing cond:Expr ")" Spacing body:Stmt
    { yyValue = "(while " + cond + " " + body + ")"; } ;

String ReturnStmt =
    "return" Spacing e:Expr ";" Spacing { yyValue = "(return " + e + ")"; }
  / "return" Spacing ";" Spacing        { yyValue = "(return)"; } ;

String VarDeclStmt =
    t:TypeSpec n:Atom "=" Spacing e:Expr ";" Spacing
    { yyValue = "(def " + n + " " + t + " " + e + ")"; }
  / t:TypeSpec n:Atom ";" Spacing
    { yyValue = "(def " + n + " " + t + ")"; } ;

String CompoundStmt =
    "{" Spacing ss:StmtList "}" Spacing
    { yyValue = "(begin " + ss + ")"; } ;

String StmtList =
    s:Stmt rest:StmtList { yyValue = s + " " + rest; }
  / /* empty */          { yyValue = ""; } ;

String ExprStmt =
    e:Expr ";" Spacing
    { yyValue = e; } ;

String Expr = AssignExpr ;

String DerefExpr =
    "*" Spacing e:Atom { yyValue = "(deref " + e + ")"; } ;

String AddrExpr =
    "&" Spacing e:Atom { yyValue = "(addr " + e + ")"; } ;

String AssignExpr =
    lhs:DerefExpr "=" Spacing rhs:CmpExpr
    { yyValue = "(= " + lhs + " " + rhs + ")"; }
  / lhs:Atom "=" Spacing rhs:CmpExpr
    { yyValue = "(= " + lhs + " " + rhs + ")"; }
  / CmpExpr ;

String CmpExpr =
    l:AddExpr op:CmpOp r:AddExpr
    { yyValue = "(" + op + " " + l + " " + r + ")"; }
  / AddExpr ;

String CmpOp =
    "<=" Spacing { yyValue = "<="; }
  / ">=" Spacing { yyValue = ">="; }
  / "<"  Spacing { yyValue = "<";  }
  / ">"  Spacing { yyValue = ">";  }
  / "==" Spacing { yyValue = "=="; }
  / "!=" Spacing { yyValue = "!="; } ;

String AddExpr =
    l:MulExpr "+" Spacing r:AddExpr { yyValue = "(+ " + l + " " + r + ")"; }
  / l:MulExpr "-" Spacing r:AddExpr { yyValue = "(- " + l + " " + r + ")"; }
  / MulExpr ;

String MulExpr =
    l:Atom "*" Spacing r:MulExpr { yyValue = "(* " + l + " " + r + ")"; }
  / l:Atom "/" Spacing r:MulExpr { yyValue = "(/ " + l + " " + r + ")"; }
  / DerefExpr
  / AddrExpr
  / FuncCall
  / Atom ;

String FuncCall =
    "csym" Spacing "::" Spacing name:Atom "(" Spacing args:ArgList ")" Spacing
    { yyValue = "(csym::" + name + " " + args + ")"; }
  / name:Atom "(" Spacing args:ArgList ")" Spacing
    { yyValue = "(" + name + " " + args + ")"; } ;

String ArgList =
    a:Expr "," Spacing rest:ArgList { yyValue = a + " " + rest; }
  / a:Expr                          { yyValue = a; }
  / /* empty */                     { yyValue = ""; } ;

String Atom =
    "(" Spacing t:TypeSpec ")" Spacing e:Atom { yyValue = "(cast " + t + " " + e + ")"; }
  / "(" Spacing e:Expr ")" Spacing { yyValue = e; }
  / s:StringLit Spacing            { yyValue = s; }
  / "this" Spacing "." Spacing f:Atom { yyValue = "this." + f; }
  / h:[a-zA-Z_] t:[a-zA-Z0-9_]* "[" Spacing idx:Expr "]" Spacing { yyValue = "(aref " + h + flatten(t) + " " + idx + ")"; }
  / h:[a-zA-Z_] t:[a-zA-Z0-9_]* Spacing { yyValue = h + flatten(t); }
  / h:[0-9] t:[0-9]* "." d:[0-9]+ Spacing { yyValue = h + flatten(t) + "." + flatten(d); }
  / h:[0-9] t:[0-9]* Spacing            { yyValue = h + flatten(t); } ;

String StringLit =
    "\"" cs:StringChar* "\""
    { StringBuilder sb = new StringBuilder("\"");
      for (String c : cs.list()) sb.append(c);
      sb.append("\"");
      yyValue = sb.toString(); } ;

String StringChar =
    h:'\\' t:_ { yyValue = String.valueOf(h) + t; }
  / h:(![\"\n] _) { yyValue = String.valueOf(h); } ;

transient void Spacing = ([ \t\n\r] / Comment)* ;

transient void Comment =
    "//" (![\n\r] _)* "\n"
  / "/*" ('*' !'/' / !'*' _)* "*/"
  ;

transient void EOF = !_ ;
