/*
 * 拡張SC (S式) → 拡張C パーザ
 *
 * 方針:
 *  - 複合式は常に括弧付きで出力する ((* 2 (+ a b)) → (2 * (a + b)))。
 *    文・条件・右辺・引数・添字など、外側の括弧が不要な位置では一番外の括弧だけ外す。
 *  - 型は TypeExpr で読み、宣言子のパターン ("int *@" の @ に名前が入る) を返す。
 *  - def / fn / ptr などの予約語は関数名として受け付けない。
 *    未知の特殊形式は関数呼び出しにならず、パースエラーになる。
 *  - 識別子のハイフンは _ に変換する (fib-start → fib_start)。
 *  - 文字列の ~% は \n、~~ は ~ に戻す。
 */
module SCParser;

body {
  private static String flatten(xtc.util.Pair<Character> cs) {
    StringBuilder sb = new StringBuilder();
    for (char c : cs) sb.append(c);
    return sb.toString();
  }

  /* SC のシンボル → C の識別子。-> はそのまま残す */
  private static String toC(String sym) {
    return sym.replaceAll("-(?!>)", "_");
  }

  /* s 全体を囲む一番外の括弧を 1 組だけ外す。文字列・文字リテラル中の括弧は数えない */
  private static String unparen(String s) {
    String t = s.trim();
    if (t.length() < 2 || t.charAt(0) != '(' || t.charAt(t.length() - 1) != ')') return t;
    int depth = 0;
    for (int i = 0; i < t.length(); i++) {
      char c = t.charAt(i);
      if (c == '"' || c == '\'') {
        for (i++; i < t.length() && t.charAt(i) != c; i++) if (t.charAt(i) == '\\') i++;
      } else if (c == '(') {
        depth++;
      } else if (c == ')') {
        depth--;
        if (depth == 0 && i != t.length() - 1) return t;  /* 先頭の ( が途中で閉じた */
      }
    }
    return t.substring(1, t.length() - 1).trim();
  }

  /* 文として出力: ; または } で終わらなければ ; を補う */
  private static String stmt(String s) {
    String t = s.trim();
    if (t.endsWith(";") || t.endsWith("}")) return t;
    return unparen(t) + ";";
  }

  private static String stripSemi(String s) {
    String t = s.trim();
    return t.endsWith(";") ? t.substring(0, t.length() - 1).trim() : t;
  }

  private static String indent(String s) {
    return "    " + s.replace("\n", "\n    ");
  }

  private static String block(xtc.util.Pair<String> ss) {
    StringBuilder sb = new StringBuilder("{\n");
    for (String s : ss) sb.append(indent(stmt(s))).append("\n");
    return sb.append("}").toString();
  }

  /* 関数・ループ本体: 単一の { } ならそのまま、そうでなければブロックで包む */
  private static String body(xtc.util.Pair<String> ss) {
    if (ss.size() == 1 && ss.head().startsWith("{")) return ss.head();
    return block(ss);
  }

  private static String asBlock(String s) {
    return s.startsWith("{") ? s : "{\n" + indent(stmt(s)) + "\n}";
  }

  /* put/get 節: 1 文なら 1 行で書く */
  private static String inlineBlock(xtc.util.Pair<String> ss) {
    if (ss.size() == 1) {
      String st = stmt(ss.head());
      if (!st.contains("\n") && !st.startsWith("{")) return "{ " + st + " }";
    }
    return body(ss);
  }

  /* 宣言子パターン: @ の位置に名前を入れる */
  private static String decl(String pat, String name) { return pat.replace("@", name); }

  private static String ptrPat(String pat) {
    return pat.contains("@[") ? pat.replace("@", "(*@)") : pat.replace("@", "*@");
  }

  /* キャスト用の型名: "int *@" → "int *", "long @" → "long" */
  private static String typeName(String pat) {
    return pat.replace("@", "").trim();
  }

  private static String params(xtc.util.Pair<String> names, xtc.util.Pair<String> types) {
    StringBuilder sb = new StringBuilder();
    java.util.Iterator<String> ti = types.iterator();
    boolean first = true;
    for (String n : names) {
      if (!first) sb.append(", ");
      sb.append(decl(ti.next(), n));
      first = false;
    }
    return sb.toString();
  }

  private static String args(xtc.util.Pair<String> as) {
    StringBuilder sb = new StringBuilder();
    boolean first = true;
    for (String a : as) {
      if (!first) sb.append(", ");
      sb.append(unparen(a));
      first = false;
    }
    return sb.toString();
  }

  /* 多引数の二項演算を左畳み込みし、各段を括弧で囲む */
  private static String fold(String op, String first, xtc.util.Pair<String> rest) {
    String acc = first;
    for (String r : rest) acc = "(" + acc + " " + op + " " + r + ")";
    return acc;
  }

  /* 単項演算子の後ろに同じ記号が続くと ++ / -- になるので空白を挟む */
  private static String prefix(String op, String e) {
    return "(" + op + (e.startsWith(op) ? " " : "") + e + ")";
  }

  private static String join(xtc.util.Pair<String> xs, String sep) {
    StringBuilder sb = new StringBuilder();
    boolean first = true;
    for (String x : xs) {
      if (!first) sb.append(sep);
      sb.append(x);
      first = false;
    }
    return sb.toString();
  }

  /* 文字列中の 1 文字を C のリテラル表記にする */
  private static String cChar(char c) {
    switch (c) {
      case '"':  return "\\\"";
      case '\\': return "\\\\";
      case '\n': return "\\n";
      case '\t': return "\\t";
      default:   return String.valueOf(c);
    }
  }
}

/* ------------------------------------------------------------------ */
/* トップレベル                                                         */
/* ------------------------------------------------------------------ */

public String start =
    Spacing ds:TopForm* EOF { yyValue = join(ds, "\n\n"); } ;

String TopForm =
    DefTask
  / DefSpecial
  / DefFunction
  / DeclFunction
  / DeclVar
  / DefVar ;

String DefTask =
    LP "def" KW LP "task" KW name:Ident RP fs:TaskField* RP
    { yyValue = "task " + name + " {\n" + join(fs, "") + "};"; } ;

String TaskField =
    LP "def" KW n:Ident t:TypeExpr d:TaskDir RP
    { yyValue = "    " + d + decl(t, n) + ";\n"; } ;

String TaskDir =
    ":in"  KW     { yyValue = "in: ";  }
  / ":out" KW     { yyValue = "out: "; }
  / /* empty */   { yyValue = "";      } ;

String DefSpecial =
    LP "def" KW LP k:SpecialKind name:Ident RP bs:Form* RP
    { yyValue = k + " " + name + " " + body(bs); } ;

String SpecialKind =
    "task-body"     KW { yyValue = "task_body";     }
  / "task-receiver" KW { yyValue = "task_receiver"; }
  / "task-sender"   KW { yyValue = "task_sender";   }
  / "rslt-sender"   KW { yyValue = "rslt_sender";   }
  / "rslt-receiver" KW { yyValue = "rslt_receiver"; } ;

String DefFunction =
    LP "def" KW LP name:FuncName ps:Ident* RP
    LP k:FnKind ret:TypeExpr ts:TypeExpr* RP &{ ps.size() == ts.size() }
    bs:Form* RP
    { yyValue = k + decl(ret, name + "(" + params(ps, ts) + ")") + " " + body(bs); } ;

String DeclFunction =
    LP "decl" KW LP name:FuncName ps:Ident* RP
    LP k:FnKind ret:TypeExpr ts:TypeExpr* RP &{ ps.size() == ts.size() } RP
    { yyValue = (k.isEmpty() ? "" : "decl ") + decl(ret, name + "(" + params(ps, ts) + ")") + ";"; } ;

String FnKind =
    "wfn" KW { yyValue = "worker "; }
  / "fn"  KW { yyValue = ""; } ;

String DeclVar =
    LP "decl" KW n:Ident t:TypeExpr RP { yyValue = decl(t, n) + ";"; } ;

String DefVar =
    LP "def" KW n:Ident t:TypeExpr e:Form RP { yyValue = decl(t, n) + " = " + unparen(e) + ";"; }
  / LP "def" KW n:Ident t:TypeExpr RP        { yyValue = decl(t, n) + ";"; } ;

String FuncName =
    "csym" Spacing "::" Spacing n:Ident { yyValue = n; }
  / Ident ;

/* ------------------------------------------------------------------ */
/* 型 (宣言子パターンを返す)                                             */
/* ------------------------------------------------------------------ */

String TypeExpr =
    LP "ptr"    KW t:TypeExpr RP        { yyValue = ptrPat(t); }
  / LP "array"  KW t:TypeExpr n:Form RP { yyValue = t.replace("@", "@[" + unparen(n) + "]"); }
  / LP "struct" KW n:Ident RP           { yyValue = "struct " + n + " @"; }
  / n:Ident                             { yyValue = n + " @"; } ;

/* ------------------------------------------------------------------ */
/* 文                                                                   */
/* ------------------------------------------------------------------ */

String Form = Statement / Expression ;

String Statement =
    BeginForm
  / IfForm
  / WhileForm
  / ForForm
  / DoTwoForm
  / ReturnForm
  / BreakForm
  / ContinueForm
  / DefVar ;

String BeginForm =
    LP "begin" KW bs:Form* RP { yyValue = block(bs); } ;

String IfForm =
    LP "if" KW c:Form t:Form e:Form RP
    { yyValue = "if (" + unparen(c) + ") " + asBlock(t) + " else " + asBlock(e); }
  / LP "if" KW c:Form t:Form RP
    { yyValue = "if (" + unparen(c) + ") " + asBlock(t); } ;

String WhileForm =
    LP "while" KW c:Form bs:Form* RP
    { yyValue = "while (" + unparen(c) + ") " + body(bs); } ;

String ForForm =
    LP "for" KW LP i:ForPart c:ForPart s:ForPart RP bs:Form* RP
    { yyValue = "for (" + i + "; " + c + "; " + s + ") " + body(bs); } ;

String ForPart =
    LP RP    { yyValue = ""; }
  / f:Form   { yyValue = unparen(stripSemi(f)); } ;

String DoTwoForm =
    LP "do-two" KW s1:Form s2:Form h:Handles? RP
    { yyValue = "do_two\n" + indent(stmt(s1)) + "\n" + indent(stmt(s2))
                + (h == null ? "" : "\n" + h); } ;

String Handles =
    LP "handles" KW name:Ident
    LP ":put" KW ps:Form* RP
    LP ":get" KW gs:Form* RP
    RP
    { yyValue = "handles " + name + " {\n"
                + indent("put: " + inlineBlock(ps)) + "\n"
                + indent("get: " + inlineBlock(gs)) + "\n}"; } ;

String ReturnForm =
    LP "return" KW e:Form RP { yyValue = "return " + unparen(e) + ";"; }
  / LP "return" KW RP        { yyValue = "return;"; } ;

String BreakForm    = LP "break"    KW RP { yyValue = "break;";    } ;
String ContinueForm = LP "continue" KW RP { yyValue = "continue;"; } ;

/* ------------------------------------------------------------------ */
/* 式 (複合式はすべて括弧付き)                                           */
/* ------------------------------------------------------------------ */

String Expression =
    LP "=" KW l:Form r:Form RP          { yyValue = "(" + l + " = " + unparen(r) + ")"; }
  / LP op:CAssignOp l:Form r:Form RP    { yyValue = "(" + l + " " + op + " " + unparen(r) + ")"; }
  / LP "aref"  KW a:Form is:Form+ RP
    { String acc = a; for (String i : is) acc = acc + "[" + unparen(i) + "]"; yyValue = acc; }
  / LP "fref"  KW o:Form f:Ident RP     { yyValue = o + "." + f; }
  / LP "cast"  KW t:TypeExpr e:Form RP  { yyValue = "((" + typeName(t) + ")" + e + ")"; }
  / LP "inc"   KW e:Form RP             { yyValue = "(" + e + "++)"; }
  / LP "dec"   KW e:Form RP             { yyValue = "(" + e + "--)"; }
  / LP "++"    KW e:Form RP             { yyValue = prefix("++", e); }
  / LP "--"    KW e:Form RP             { yyValue = prefix("--", e); }
  / LP "ptr"   KW e:Form RP             { yyValue = prefix("&", e); }
  / LP "mref"  KW e:Form RP             { yyValue = prefix("*", e); }
  / LP "exps"  KW es:Form+ RP           { yyValue = "(" + args(es) + ")"; }
  / LP "not"   KW e:Form RP             { yyValue = prefix("!", e); }
  / LP "and"   KW a:Form rs:Form+ RP    { yyValue = fold("&&", a, rs); }
  / LP "or"    KW a:Form rs:Form+ RP    { yyValue = fold("||", a, rs); }
  / LP op:BinOp a:Form rs:Form+ RP      { yyValue = fold(op, a, rs); }
  / LP "-"     KW a:Form RP             { yyValue = prefix("-", a); }
  / LP n:FuncName as:Form* RP           { yyValue = n + "(" + args(as) + ")"; }
  / StringLit
  / Number
  / Ident ;

String CAssignOp =
    "+=" KW { yyValue = "+="; }
  / "-=" KW { yyValue = "-="; }
  / "*=" KW { yyValue = "*="; }
  / "/=" KW { yyValue = "/="; } ;

String BinOp =
    "<=" KW { yyValue = "<="; }
  / ">=" KW { yyValue = ">="; }
  / "==" KW { yyValue = "=="; }
  / "!=" KW { yyValue = "!="; }
  / "<"  KW { yyValue = "<";  }
  / ">"  KW { yyValue = ">";  }
  / "+"  KW { yyValue = "+";  }
  / "-"  KW { yyValue = "-";  }
  / "*"  KW { yyValue = "*";  }
  / "/"  KW { yyValue = "/";  }
  / "%"  KW { yyValue = "%";  } ;

/* ------------------------------------------------------------------ */
/* 字句                                                                 */
/* ------------------------------------------------------------------ */

String Ident =
    !Reserved h:[a-zA-Z_] t:[a-zA-Z0-9_\-.>]* !SymChar Spacing
    { yyValue = toC(h + flatten(t)); } ;

String Number =
    s:"-"? h:[0-9] t:[0-9]* f:Fraction? x:Exponent? !SymChar Spacing
    { yyValue = (s == null ? "" : "-") + h + flatten(t)
                + (f == null ? "" : f) + (x == null ? "" : x); } ;

String Fraction = "." d:[0-9]+ { yyValue = "." + flatten(d); } ;
String Exponent = e:[eE] s:[+\-]? d:[0-9]+
    { yyValue = String.valueOf(e) + (s == null ? "" : String.valueOf(s)) + flatten(d); } ;

/* SC の文字列 (Lisp の \ エスケープ + format の ~% ~~) → C の文字列リテラル */
String StringLit =
    "\"" cs:SChar* "\"" Spacing { yyValue = "\"" + join(cs, "") + "\""; } ;

String SChar =
    '\\' c:_          { yyValue = cChar(c); }
  / "~%"              { yyValue = "\\n"; }
  / "~~"              { yyValue = "~"; }
  / c:(![\"\\~] _)    { yyValue = cChar(c); } ;

/* 関数名・変数名として使えない語 (未知の特殊形式を呼び出し扱いしないため) */
transient void Reserved =
    "def" !SymChar / "decl" !SymChar / "fn" !SymChar / "wfn" !SymChar
  / "ptr" !SymChar / "array" !SymChar / "struct" !SymChar / "cast" !SymChar
  / "if" !SymChar / "begin" !SymChar / "for" !SymChar / "while" !SymChar
  / "return" !SymChar / "break" !SymChar / "continue" !SymChar
  / "do-two" !SymChar / "do-many" !SymChar / "handles" !SymChar
  / "dynamic-wind" !SymChar
  / "aref" !SymChar / "fref" !SymChar / "addr" !SymChar / "deref" !SymChar / "mref" !SymChar
  / "inc" !SymChar / "dec" !SymChar / "not" !SymChar / "and" !SymChar / "or" !SymChar
  / "task" !SymChar / "task-body" !SymChar / "task-sender" !SymChar / "task-receiver" !SymChar
  / "rslt-sender" !SymChar / "rslt-receiver" !SymChar / "task-exec" !SymChar
  / "let" !SymChar / "exps" !SymChar / "if-exp" !SymChar / "switch" !SymChar
  / "c-exp" !SymChar / "csym" !SymChar ;

transient void LP = "(" Spacing ;
transient void RP = ")" Spacing ;

/* キーワードの後の単語境界 */
transient void KW = !SymChar Spacing ;
transient void SymChar = !Delim _ ;
transient void Delim = ' ' / '\t' / '\n' / '\r' / '(' / ')' / '"' / ';' ;

transient void Spacing = ([ \t\n\r] / Comment)* ;

/* ; から行末までがコメント (;; も含む) */
transient void Comment = ";" (![\n\r] _)* ;

transient void EOF = !_ ;
